{
  "Comment": "Is it a dog or a cat?",
  "QueryLanguage": "JSONata",
  "StartAt": "IsDogOrCat",
  "States": {
    "IsDogOrCat": {
      "Comment": "Calls Rekognition directly using the AWS SDK service integration",
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:rekognition:detectLabels",
      "Arguments": {
        "Image": {
          "S3Object": {
            "Bucket": "{% $states.input.bucket %}",
            "Name": "{% $states.input.key %}"
          }
        },
        "MaxLabels": 10,
        "MinConfidence": 70
      },
      "Output": {
        "bucket": "{% $states.input.bucket %}",
        "key": "{% $states.input.key %}",
        "animal": "{% $count($states.result.Labels[Name = 'Dog']) > 0 ? 'Dog' : $count($states.result.Labels[Name = 'Cat']) > 0 ? 'Cat' : 'Unknown' %}"
      },
      "Next": "ChoiceState"
    },
    "ChoiceState": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $states.input.animal = 'Dog' %}",
          "Next": "DogFound"
        },
        {
          "Condition": "{% $states.input.animal = 'Cat' %}",
          "Next": "CatFound"
        }
      ],
      "Default": "UnknownAnimal"
    },
    "DogFound": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${DogFoundFunctionArn}",
        "Payload": "{% $states.input %}"
      },
      "Output": "{% $states.result.Payload %}",
      "End": true
    },
    "CatFound": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${CatFoundFunctionArn}",
        "Payload": "{% $states.input %}"
      },
      "Output": "{% $states.result.Payload %}",
      "End": true
    },
    "UnknownAnimal": {
      "Type": "Fail",
      "Error": "DefaultStateError",
      "Cause": "No Matches!"
    }
  }
}
